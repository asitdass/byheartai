# Optional. After deploy, paste tokens from Search Console / Bing Webmaster.
# Vercel → Project → Settings → Environment Variables.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional. Use the HTTPS base URL of your Matomo installation and its numeric website ID.
MATOMO_URL=
MATOMO_SITE_ID=
# Enable to include filtered search phrases in Matomo's Site Search report.
MATOMO_RECORD_SEARCH_TERMS=false
